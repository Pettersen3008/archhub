{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchHub",
  "version": "0.1.0",
  "identifier": "dev.archhub.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchHub",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#f7f8f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "shortDescription": "Inspect and manage Arch packages with security evidence",
    "category": "Utility"
  }
}
