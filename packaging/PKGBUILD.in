# Generated by scripts/prepare-release.py from a committed source revision.
pkgbase=archhub
pkgname=(archhub archhub-helper)
pkgver=@VERSION@
pkgrel=1
pkgdesc='Security-focused package dashboard for Arch Linux and Omarchy'
arch=('x86_64')
url='https://github.com/Pettersen3008/archhub'
license=('GPL-3.0-only')
makedepends=('rust' 'bun>=1.4' 'pkgconf' 'gtk3' 'webkit2gtk-4.1' 'python' 'desktop-file-utils')
source=("archhub-$pkgver.tar.gz::$url/releases/download/v$pkgver/archhub-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$srcdir/archhub-$pkgver"
  bun install --frozen-lockfile
  cargo fetch --locked
}

build() {
  cd "$srcdir/archhub-$pkgver"
  # An absolute shared cache can be supplied for local rebuilds.
  if [[ -n ${CARGO_TARGET_DIR:-} && $CARGO_TARGET_DIR != /* ]]; then
    printf '%s\n' 'CARGO_TARGET_DIR must be an absolute path.' >&2
    return 1
  fi
  bun run build:desktop
  cargo build --release --locked -p archhub-core -p archhub-helper
}

check() {
  cd "$srcdir/archhub-$pkgver"
  cargo test --workspace --locked
  desktop-file-validate packaging/dev.archhub.desktop.desktop
}

package_archhub() {
  depends=('pacman>=7.1' 'libalpm.so=16-64' 'glibc' 'libgcc' 'gtk3' 'webkit2gtk-4.1')
  optdepends=('archhub-helper: authenticated reviewed removal in the desktop app'
              'pacman-contrib: repository update checks and cache cleanup previews'
              'yay: interactive AUR package handoffs'
              'paru: interactive AUR package handoffs')
  cd "$srcdir/archhub-$pkgver"
  local binary_dir="${CARGO_TARGET_DIR:-$PWD/target}/release"
  install -Dm755 "$binary_dir/archhub-desktop" "$pkgdir/usr/bin/archhub"
  install -Dm755 "$binary_dir/archhub-core" "$pkgdir/usr/bin/archhub-cli"
  install -Dm644 packaging/dev.archhub.desktop.desktop "$pkgdir/usr/share/applications/dev.archhub.desktop.desktop"
  install -Dm644 public/archhub.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.archhub.desktop.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/archhub/LICENSE"
  install -Dm644 LICENSES/DM-Sans.txt "$pkgdir/usr/share/licenses/archhub/DM-Sans.txt"
  install -Dm644 LICENSES/Manrope.txt "$pkgdir/usr/share/licenses/archhub/Manrope.txt"
  install -Dm644 LICENSES/IBM-Plex-Mono.txt "$pkgdir/usr/share/licenses/archhub/IBM-Plex-Mono.txt"
}

package_archhub-helper() {
  pkgdesc='Optional authenticated one-shot removal helper for ArchHub'
  depends=('pacman>=7.1' 'libalpm.so=16-64' 'glibc' 'libgcc' 'polkit')
  cd "$srcdir/archhub-$pkgver"
  local binary_dir="${CARGO_TARGET_DIR:-$PWD/target}/release"
  install -Dm755 "$binary_dir/archhub-helper" "$pkgdir/usr/lib/archhub/archhub-helper"
  install -Dm644 packaging/dev.archhub.remove.policy "$pkgdir/usr/share/polkit-1/actions/dev.archhub.remove.policy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/archhub-helper/LICENSE"
}
